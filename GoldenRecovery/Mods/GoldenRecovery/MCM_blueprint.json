                        {
                            "Id": "useWholePartyMoney",
                            "Name": "Use Whole Party Money",
                            "Type": "checkbox",
                            "Description": "Toggle this to check money from whole party instead of just the caster.\nIf toggled and the caster doesn't have enough money, they will be taken from the next party member with enough money.\nIf toggled off and the caster doesn't have enough money but the party does, the spell will still fail.",
                            "Default": false,
                            "Handles": {
                                "NameHandle": "h8b347f29g8534g4a9fg9934gae6130788915",
                                "DescriptionHandle": "ha158497fgc5f7g4025gb0b9g563b30c7a4e1"
                            }
                        },
